# Server only. Never copy these values into the website, Android app or GitHub.
RVS_ENVIRONMENT=sandbox
AMAZON_SHARED_SECRET=
# Set exactly one signing-key source. Separate sandbox/production keys are recommended.
RVS_SIGNING_PRIVATE_KEY_FILE=
RVS_SIGNING_PRIVATE_KEY_PEM_B64=
ALLOW_AMAZON_TEST_TRANSACTIONS=false
HOST=127.0.0.1
PORT=8080
