# Development tools only; never bundle this file in an APK.
DEEPL_AUTH_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# Amazon public app authentication PEM belongs in android/app/src/main/assets/.
# Signing credentials are configured outside version control; see docs/BUILD_AND_RELEASE.md.
# Receipt-verifier secrets have a separate SERVER-ONLY template:
# server/receipt-verifier/.env.example. Never put those secrets in Android or website configuration.
# Android accepts only public Gradle properties: lifetaleaRvsUrl, lifetaleaRvsPublicKey,
# lifetaleaRvsEnvironment (debug), and lifetaleaPurchasesEnabled (off until live tests pass).
